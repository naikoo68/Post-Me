# Production backend env for a self-managed host (e.g. an Oracle Cloud VM).
# Copy to `postme.env`, fill in the blanks, then run:
#   docker run -d --name postme-backend --restart always --network postme-net \
#     --env-file postme.env -p 127.0.0.1:5000:5000 postme-backend
# NOTE: never commit the filled-in postme.env — it holds secrets.

# ---- Server ----
NODE_ENV=production
PORT=5000
# Your Post Me frontend origin (CORS + the card pages the renderer screenshots)
CLIENT_URL=https://www.postme.example
# Optional: allow every subdomain of your platform domain (client sub-sites)
# PLATFORM_BASE_DOMAIN=postme.example

# ---- Multi-tenancy (every Post Me client is a tenant) ----
# MUST stay "on" in production: client data isolation is only auto-enforced
# when this is on. tests/tenantEnforcement.test.js fails the build otherwise.
TENANT_ENFORCEMENT=on

# ---- Database engine: mongo | oracle | dynamo ----
DB_ENGINE=mongo
MONGO_URI=
# ORACLE_MONGO_URI=
# ORACLE_MAX_POOL=20
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_PREFIX=postme_

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Encrypts stored YouTube refresh tokens at rest
AI_KEY_ENC_SECRET=replace_with_a_long_random_secret

# ---- Super-admin bootstrap ----
ADMIN_EMAIL=admin@postme.example
ADMIN_PASSWORD=

# ---- Image/video hosting (Cloudinary) — required for posting ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- YouTube (optional platform-wide OAuth app fallback) ----
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=https://api.postme.example/api/youtube/oauth/callback

# ---- Narration / TTS (optional fallbacks; normally set per client in the panel) ----
# OPENAI_TTS_API_KEY=
# ELEVENLABS_API_KEY=
# GOOGLE_CLOUD_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Own cloned voice (voice-server/). Set automatically by the deploy-voice workflow.
# VOICE_SERVER_URL=http://postme-voice:8000
# VOICE_SERVER_TOKEN=

# ---- Email (optional; SMTP) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL=

# ---- Payments for client plans (optional; Razorpay) ----
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
