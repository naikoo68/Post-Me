# Local development env. Copy to `.env`.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database engine: mongo | dynamo | oracle
DB_ENGINE=mongo
MONGO_URI=mongodb://127.0.0.1:27017/postme

# --- AWS DynamoDB (DB_ENGINE=dynamo) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_PREFIX=postme_
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- Oracle Autonomous DB via MongoDB API (DB_ENGINE=oracle) ---
# ORACLE_MONGO_URI=
# ORACLE_MAX_POOL=20

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Encrypts stored YouTube OAuth refresh tokens at rest (AES-256-GCM)
AI_KEY_ENC_SECRET=CHANGE_ME_to_a_long_random_secret

# Super-admin bootstrap (created/recovered at startup). Use a strong password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password
# ADMIN_RESET=true

# Cloudinary — hosts the rendered post images, reels and slideshows
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rendering: system Chromium (card screenshots) + ffmpeg (reels / long videos)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# FFMPEG_PATH=ffmpeg
# LONG_VIDEO_PARALLEL=1

# Narration (TTS) — normally chosen per client in the admin panel; free Edge
# engine needs no key. These are optional fallbacks.
# OPENAI_TTS_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1
# ELEVENLABS_API_KEY=
# GOOGLE_CLOUD_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# VOICE_SERVER_URL=http://localhost:8000
# VOICE_SERVER_TOKEN=

# YouTube (optional platform-wide OAuth app; normally pasted in the admin panel)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth/callback

# Email (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_EMAIL=

# Payments for client plans (optional; Razorpay)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
